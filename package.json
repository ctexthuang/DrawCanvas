{
  "name": "draw-canvas",
  "productName": "Draw Canvas",
  "version": "0.0.1",
  "description": "Draw Canvas AI creative desktop workspace",
  "author": "ctexthuang",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/ctexthuang/DrawCanvas.git"
  },
  "config": {
    "forge": "./forge.config.cjs"
  },
  "build": {
    "appId": "com.ctexthuang.drawcanvas",
    "productName": "Draw Canvas",
    "directories": {
      "output": "dist/make/nsis"
    },
    "files": [
      "out/**/*"
    ],
    "artifactName": "Draw-Canvas-${version}-${arch}-Setup.${ext}",
    "win": {
      "icon": "assets/icons/app-icon.ico",
      "executableName": "DrawCanvas"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "installerIcon": "assets/icons/app-icon.ico",
      "uninstallerIcon": "assets/icons/app-icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Draw Canvas",
      "include": "assets/installer/nsis-custom.nsh"
    }
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.12.0 <23",
    "pnpm": ">=11.7.0 <12"
  },
  "volta": {
    "node": "22.23.1",
    "pnpm": "11.7.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && electron-vite build",
    "package": "pnpm build && electron-forge package",
    "make": "pnpm build && electron-forge make",
    "preview": "electron-vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.29.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-wix": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.3.0",
    "electron-builder": "26.15.7",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
